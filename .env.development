# In dev, talk to Vite (same-origin) and let it proxy to your local Dev-co API.
# Start the backend once: cd Dev-co && npm run dev
# Login dropdown sends X-Dispatch-Environment (test | prod) — no need to restart the server.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
# Load images directly from S3 — avoids slow Vite → Railway proxy for /uploads
VITE_UPLOADS_BASE_URL=https://dispatch-co-uploads-gbeyes.s3.us-east-1.amazonaws.com
VITE_UPLOADS_PROXY_TARGET=http://localhost:4000
# Load images via edge CDN (wsrv.nl) instead of slow direct S3 us-east-1.
# Set to off to use S3 URLs directly.
VITE_MEDIA_EDGE_CDN=wsrv
# Get a key from Google Cloud → enable Maps JavaScript API + Geocoding API + billing
# VITE_GOOGLE_MAPS_API_KEY=
